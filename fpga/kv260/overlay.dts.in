/dts-v1/;
/plugin/;
/ {
    fragment@0 {
        target = <&fpga_full>;
        __overlay__ { firmware-name = "fades.bit.bin"; };
    };
    fragment@1 {
        target = <&amba>;
        __overlay__ {
            #address-cells = <2>;
            #size-cells = <2>;
            sudoku@a0010000 {
                compatible = "fades,solver-3.0";
                reg = <0x0 0xa0010000 0x0 0x1000>,
                      <0x0 0xa0000000 0x0 0x10000>;
                reg-names = "solver", "dma";
                clocks = <&zynqmp_clk 71>, <&zynqmp_clk 72>;
                clock-names = "dma", "core";
                assigned-clocks = <&zynqmp_clk 71>, <&zynqmp_clk 72>;
                assigned-clock-rates = <@dma_hz@>, <@core_hz@>;
                interrupt-parent = <&gic>;
                interrupts = <0 89 4>, <0 90 4>;
                interrupt-names = "tx", "rx";
                /* HP ports are noncoherent: deliberately no dma-coherent. */
            };
        };
    };
};
