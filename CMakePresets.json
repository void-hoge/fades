{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "FADES_BUILD_HOST": "OFF",
        "FADES_BUILD_DRIVER": "OFF",
        "FADES_BUILD_SIM": "OFF",
        "FADES_BUILD_FPGA": "OFF"
      }
    },
    {
      "name": "host", "inherits": "base",
      "displayName": "Development tools and RTL simulation",
      "cacheVariables": { "FADES_BUILD_HOST": "ON", "FADES_BUILD_SIM": "ON", "BUILD_TESTING": "ON" }
    },
    {
      "name": "kv260-ps", "inherits": "base",
      "displayName": "KV260 userspace tools and kernel module (native build)",
      "cacheVariables": { "FADES_BUILD_HOST": "ON", "FADES_BUILD_DRIVER": "ON", "BUILD_TESTING": "ON" }
    },
    {
      "name": "kv260-pl", "inherits": "base",
      "displayName": "KV260 FPGA implementation and firmware",
      "cacheVariables": { "FADES_BUILD_FPGA": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "host", "configurePreset": "host" },
    { "name": "kv260-pl", "configurePreset": "kv260-pl" },
    { "name": "kv260-ps", "configurePreset": "kv260-ps" }
  ],
  "testPresets": [
    { "name": "host", "configurePreset": "host", "output": { "outputOnFailure": true } },
    { "name": "kv260-ps", "configurePreset": "kv260-ps", "output": { "outputOnFailure": true } }
  ]
}
