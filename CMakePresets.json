{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "FADES_BUILD_HOST": "OFF",
        "FADES_BUILD_SIM": "OFF",
        "FADES_BUILD_FPGA": "OFF"
      }
    },
    {
      "name": "host-native", "inherits": "base",
      "cacheVariables": { "FADES_BUILD_HOST": "ON", "BUILD_TESTING": "ON" }
    },
    {
      "name": "host-kv260", "inherits": "base",
      "cacheVariables": { "FADES_BUILD_HOST": "ON", "BUILD_TESTING": "ON" }
    },
    {
      "name": "sim", "inherits": "base",
      "cacheVariables": { "FADES_BUILD_SIM": "ON", "BUILD_TESTING": "ON" }
    },
    {
      "name": "fpga-kv260", "inherits": "base",
      "cacheVariables": { "FADES_BUILD_FPGA": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "host-native", "configurePreset": "host-native" },
    { "name": "host-kv260", "configurePreset": "host-kv260" },
    { "name": "sim", "configurePreset": "sim" },
    { "name": "fpga-kv260", "configurePreset": "fpga-kv260" }
  ],
  "testPresets": [
    { "name": "host-native", "configurePreset": "host-native", "output": { "outputOnFailure": true } },
    { "name": "host-kv260", "configurePreset": "host-kv260", "output": { "outputOnFailure": true } },
    { "name": "sim", "configurePreset": "sim", "output": { "outputOnFailure": true } }
  ]
}
